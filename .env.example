# Example environment variables for the Style-Enhancer server
# Copy this file to `.env` and fill in real values (do NOT commit secrets)

# Server
NODE_ENV=development
PORT=5000

# SMTP (used to forward contact form messages to your email)
# Use your SMTP provider (SendGrid, Mailgun, Gmail SMTP, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-api-key
CONTACT_TO_EMAIL=you@example.com
